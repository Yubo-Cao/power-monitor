<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PowerMonitor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Chart series: validated categorical slots 1-4, stepped per theme. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SeriesCpu" Color="#2a78d6" />
                    <SolidColorBrush x:Key="SeriesIGpu" Color="#eb6834" />
                    <SolidColorBrush x:Key="SeriesDGpu" Color="#1baf7a" />
                    <SolidColorBrush x:Key="SeriesRest" Color="#eda100" />
                    <SolidColorBrush x:Key="ChartGrid" Color="#e1e0d9" />
                    <SolidColorBrush x:Key="ChartMuted" Color="#898781" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SeriesCpu" Color="#3987e5" />
                    <SolidColorBrush x:Key="SeriesIGpu" Color="#d95926" />
                    <SolidColorBrush x:Key="SeriesDGpu" Color="#199e70" />
                    <SolidColorBrush x:Key="SeriesRest" Color="#c98500" />
                    <SolidColorBrush x:Key="ChartGrid" Color="#2c2c2a" />
                    <SolidColorBrush x:Key="ChartMuted" Color="#898781" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="TileLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,0" />
            </Style>
            <Style x:Key="TileNote" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
