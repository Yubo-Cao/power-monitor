<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PowerMonitor.App.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PowerMonitor.App.Pages"
    xmlns:c="using:PowerMonitor.App.Controls">
    <Grid Padding="32,16,32,24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="放电记录" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="Summary" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
            <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:SessionItem">
                        <Grid Padding="8,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind Projected}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="满电可用" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="1">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="200" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DetailTitle" Text="电量" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:TimeChart x:Name="ChargeChart" Grid.Row="1" Stacked="False" Unit="%" ValueFormat="0" FixedMax="100" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="240" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="功耗构成" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:TimeChart x:Name="PowerChart" Grid.Row="1" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="这次放电里耗电最多的应用" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <c:AppEnergyList x:Name="AppList" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
